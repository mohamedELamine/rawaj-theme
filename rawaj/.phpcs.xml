<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/squizlabs/PHP_CodeSniffer/master/phpcs.xsd"
         name="Rawaj Theme Coding Standards">
  <description>Coding standards for Rawaj WordPress theme</description>
  
  <file>.</file>
  
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/.git/*</exclude-pattern>
  <exclude-pattern>*/tests/*</exclude-pattern>
  <exclude-pattern>*.min.js</exclude-pattern>
  <exclude-pattern>*.min.css</exclude-pattern>
  
  <arg name="extensions" value="php"/>
  <arg name="colors"/>
  <arg name="parallel" value="8"/>
  <arg value="s"/>
  <arg value="p"/>
  
  <config name="testVersion" value="8.0-"/>
  <config name="minimum_wp_version" value="6.4"/>
  <config name="minimum_supported_wp_version" value="6.4"/>
  
  <rule ref="WordPress-Core">
  </rule>
  
  <rule ref="WordPress-Docs">
    <severity>6</severity>
  </rule>
  
  <rule ref="WordPress.Files.FileName.InvalidClassFileName">
    <severity>0</severity>
  </rule>
  
  <rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
    <properties>
      <property name="prefixes" type="array" value="rawaj"/>
    </properties>
  </rule>
  
  <rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedFunctionFound">
    <properties>
      <property name="prefixes" type="array" value="rawaj"/>
    </properties>
  </rule>
  
  <rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedConstantFound">
    <properties>
      <property name="prefixes" type="array" value="RAWAJ"/>
    </properties>
  </rule>
  
  <rule ref="PSR12.Files.FileHeader.SpacingAfterBlock">
    <severity>0</severity>
  </rule>
  
  <rule ref="Squiz.Commenting">
    <severity>4</severity>
  </rule>
  
  <rule ref="Generic.Arrays.DisallowLongArraySyntax.Found">
    <type>warning</type>
  </rule>
  
  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array" value="rawaj"/>
    </properties>
  </rule>
</ruleset>