{
  "version": 3,
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "settings": {
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "name": "Primary",
          "slug": "primary",
          "color": "#1a1a1a"
        },
        {
          "name": "Primary Light",
          "slug": "primary-light",
          "color": "#2d2d2d"
        },
        {
          "name": "Accent",
          "slug": "accent",
          "color": "#c4a572"
        },
        {
          "name": "Accent Dark",
          "slug": "accent-dark",
          "color": "#8b7355"
        },
        {
          "name": "Background",
          "slug": "bg",
          "color": "#f8f6f3"
        },
        {
          "name": "Background Alt",
          "slug": "bg-alt",
          "color": "#faf8f5"
        },
        {
          "name": "Text",
          "slug": "text",
          "color": "#2a2a2a"
        },
        {
          "name": "Text Light",
          "slug": "text-light",
          "color": "#666666"
        },
        {
          "name": "Border",
          "slug": "border",
          "color": "#e8e6e3"
        },
        {
          "name": "Success",
          "slug": "success",
          "color": "#4caf50"
        },
        {
          "name": "Warning",
          "slug": "warning",
          "color": "#ff9800"
        },
        {
          "name": "Error",
          "slug": "error",
          "color": "#f44336"
        },
        {
          "name": "Info",
          "slug": "info",
          "color": "#2196f3"
        },
        {
          "name": "White",
          "slug": "white",
          "color": "#ffffff"
        }
      ],
      "gradients": [],
      "text": false,
      "background": false
    },
    "typography": {
      "fontFamilies": [
        {
          "name": "Heading",
          "slug": "heading",
          "fontFamily": "'Cairo', sans-serif"
        },
        {
          "name": "Body",
          "slug": "body",
          "fontFamily": "'Tajawal', sans-serif"
        }
      ],
      "fontSizes": [
        {
          "name": "Extra Small",
          "slug": "extra-small",
          "size": "12px"
        },
        {
          "name": "Small",
          "slug": "small",
          "size": "14px"
        },
        {
          "name": "Medium",
          "slug": "medium",
          "size": "16px"
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "18px"
        },
        {
          "name": "Extra Large",
          "slug": "extra-large",
          "size": "24px"
        },
        {
          "name": "2X Large",
          "slug": "2x-large",
          "size": "28px"
        },
        {
          "name": "3X Large",
          "slug": "3x-large",
          "size": "36px"
        },
        {
          "name": "5X Large",
          "slug": "5x-large",
          "size": "56px"
        }
      ],
      "lineHeight": true
    },
    "spacing": {
      "spacingSizes": [
        {
          "name": "Extra Small",
          "slug": "extra-small",
          "size": "4px"
        },
        {
          "name": "Small",
          "slug": "small",
          "size": "8px"
        },
        {
          "name": "Medium",
          "slug": "medium",
          "size": "16px"
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "24px"
        },
        {
          "name": "Extra Large",
          "slug": "extra-large",
          "size": "32px"
        },
        {
          "name": "2X Large",
          "slug": "2x-large",
          "size": "48px"
        },
        {
          "name": "3X Large",
          "slug": "3x-large",
          "size": "64px"
        }
      ],
      "units": ["px", "%", "em", "rem", "vw", "vh"]
    },
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1400px"
    },
    "border": {
      "radius": [
        {
          "name": "None",
          "slug": "none",
          "size": "0px"
        },
        {
          "name": "Small",
          "slug": "small",
          "size": "4px"
        },
        {
          "name": "Medium",
          "slug": "medium",
          "size": "8px"
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "12px"
        }
      ]
    },
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "custom": {
      "lineHeight": {
        "tight": "1.2",
        "normal": "1.5",
        "relaxed": "1.75"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--bg)",
      "text": "var(--wp--preset--color--text)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "var(--wp--custom--line-height--normal)"
    },
    "spacing": {
      "padding": {
        "top": "0",
        "right": "0",
        "bottom": "0",
        "left": "0"
      }
    },
    "elements": {
      "button": {
        "color": {
          "background": "var(--wp--preset--color--accent)",
          "text": "var(--wp--preset--color--primary)"
        },
        "border": {
          "radius": "8px"
        },
        "spacing": {
          "padding": {
            "top": "12px",
            "right": "24px",
            "bottom": "12px",
            "left": "24px"
          }
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--accent-dark)"
          }
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "900",
          "lineHeight": "var(--wp--custom--line-height--tight)"
        },
        "color": {
          "text": "var(--wp--preset--color--text)"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--accent)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--accent-dark)"
          }
        }
      }
    },
    "blocks": {
      "core/heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)"
        }
      },
      "core/paragraph": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontSize": "var(--wp--preset--font-size--medium)"
        }
      },
      "core/button": {
        "color": {
          "background": "var(--wp--preset--color--accent)",
          "text": "var(--wp--preset--color--primary)"
        },
        "border": {
          "radius": "8px"
        },
        "spacing": {
          "padding": {
            "top": "12px",
            "right": "24px",
            "bottom": "12px",
            "left": "24px"
          }
        }
      },
      "core/list": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "lineHeight": "1.6"
        }
      },
      "core/image": {
        "border": {
          "radius": "8px"
        }
      },
      "core/group": {
        "spacing": {
          "padding": {
            "top": "48px",
            "right": "24px",
            "bottom": "48px",
            "left": "24px"
          }
        }
      },
      "core/columns": {
        "spacing": {
          "gap": "24px"
        }
      },
      "core/cover": {
        "color": {
          "text": "var(--wp--preset--color--white)"
        }
      },
      "woocommerce/product": {
        "color": {
          "text": "var(--wp--preset--color--text)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)"
        }
      },
      "woocommerce/product-price": {
        "color": {
          "text": "var(--wp--preset--color--accent)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)",
          "fontWeight": "700"
        }
      },
      "woocommerce/product-button": {
        "color": {
          "background": "var(--wp--preset--color--accent)",
          "text": "var(--wp--preset--color--primary)"
        },
        "border": {
          "radius": "8px"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontWeight": "600"
        },
        "spacing": {
          "padding": {
            "top": "12px",
            "right": "24px",
            "bottom": "12px",
            "left": "24px"
          }
        }
      },
      "woocommerce/cart": {
        "color": {
          "background": "var(--wp--preset--color--bg)",
          "text": "var(--wp--preset--color--text)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)"
        }
      },
      "woocommerce/checkout": {
        "color": {
          "background": "var(--wp--preset--color--bg)",
          "text": "var(--wp--preset--color--text)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)"
        }
      },
      "core/template-part": {
        "spacing": {
          "margin": {
            "top": "0",
            "bottom": "0"
          }
        }
      },
      "core/navigation": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontSize": "var(--wp--preset--font-size--medium)"
        },
        "spacing": {
          "gap": "var(--wp--preset--spacing--medium)"
        }
      },
      "core/site-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontSize": "var(--wp--preset--font-size--2x-large)",
          "fontWeight": "900"
        },
        "color": {
          "text": "var(--wp--preset--color--text)"
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontSize": "var(--wp--preset--font-size--3x-large)"
        },
        "color": {
          "text": "var(--wp--preset--color--text)"
        },
        "spacing": {
          "margin": {
            "bottom": "var(--wp--preset--spacing--medium)"
          }
        }
      },
      "core/post-content": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontSize": "var(--wp--preset--font-size--medium)",
          "lineHeight": "var(--wp--custom--line-height--relaxed)"
        }
      }
    },
    "customTemplates": {
      "home": {
        "title": "Home Page Template"
      },
      "single-product": {
        "title": "Single Product Template"
      },
      "archive-product": {
        "title": "Product Archive Template"
      },
      "cart": {
        "title": "Cart Template"
      },
      "checkout": {
        "title": "Checkout Template"
      }
    }
  }
}